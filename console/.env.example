# Northlight console settings. Names only: put real values in Vercel (or a local .env.local that git ignores), never here.
# For a local run without any real service, use scripts/fake.env through `node scripts/fake-app.mjs` (README).

# Supabase: sign-in and the agent_access table. The two NEXT_PUBLIC_ values are public by design.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Adds people, reads the People list, records what the agent accepted.
SUPABASE_SERVICE_ROLE_KEY=

# The businesses this app serves, in the order they are listed: [{"id":"kestrel","name":"Kestrel Garage"}]
AGENT_CLIENTS=
# Northlight admins, by sign-in email, comma separated. They manage people and may decide any request.
AGENT_ADMINS=

# The agent Worker's address, shared by every business.
AGENT_BRAIN_URL=

# Per business, named after its id in capitals (kestrel -> KESTREL). Each holds the same value as the agent secret named
# in agent/clients/<id>/client.json: tokenEnv, userSigningEnv, approverSigningEnv, accessSigningEnv.
BRAIN_TOKEN_KESTREL=
BRAIN_USER_SIGNING_KEY_KESTREL=
BRAIN_APPROVER_SIGNING_KEY_KESTREL=
ACCESS_SIGNING_KEY_KESTREL=

# Optional, server only: Iris call history from the voice provider (ElevenLabs). Leave all unset for web chat only.
IRIS_CALL_HISTORY_KEY=
IRIS_CALL_AGENT_ID=
IRIS_CALL_BRANCH_ID=
# Iris's phone line in E.164 (+44...), and how the desk shows it (optional).
IRIS_CALL_LINE=
IRIS_CALL_LINE_LABEL=
# Staff handset assignments for call history. See Iris call history in README.
KESTREL_HISTORY_CALLERS=
