# Copy to desk/.dev.vars for `wrangler dev -c wrangler.jsonc -c desk/wrangler.jsonc`. Never commit real values.
# One line per env var NAME used in a connection's `auth` (clients/kestrel/iris.json).
# In production: `npx wrangler secret put <NAME> --config desk/wrangler.jsonc`.
# The brain (.dev.vars) holds none of these: only its model key, client token and signing keys.

# Client media library: S3 credentials of an R2 API token (Object Read & Write on the northlight-media bucket only) and the
# Cloudflare account id; they sign upload links (mediaUploadUrl). Optional until staff upload media.
R2_MEDIA_ACCESS_KEY_ID=
R2_MEDIA_SECRET_ACCESS_KEY=
R2_MEDIA_ACCOUNT_ID=

# Iris (all optional; each tool reports "not connected" without its key).
# Fine-grained GitHub token, read-only on the site repo: pull requests for the deployed commit.
KESTREL_RELEASE_GITHUB_TOKEN=
# Fine-grained GitHub token, contents and pull requests write on the site repo: homepage and Services title previews.
KESTREL_PREVIEW_GITHUB_TOKEN=
# Google PageSpeed. Without it, page_audit uses the low shared quota.
PAGESPEED_API_KEY=
