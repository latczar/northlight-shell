{
  "name": "kestrel-garage-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test",
    "check": "npm run build && npm test && npm run check:worker && npm run test:e2e",
    "test:e2e": "playwright test",
    "test:browser": "node build.mjs && playwright test",
    "check:worker": "wrangler deploy --dry-run --outdir .wrangler/check",
    "dev:worker": "wrangler dev",
    "preview": "node build.mjs && node serve.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@playwright/test": "1.65.1",
    "esbuild": "0.28.2",
    "miniflare": "5.20261103.0-beta",
    "wrangler": "4.157.0"
  },
  "dependencies": {
    "jose": "6.2.18"
  }
}
